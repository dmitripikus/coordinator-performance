+async def _bench_on_response_chunk_received(session, trace_config_ctx, params):
+    """bench13 patch: record wire-arrival timestamp of each response chunk.
+
+    aiohttp fires this from the same context that feeds bytes to the StreamReader,
+    which runs directly from the event loop's protocol callback — much closer to
+    true wire-arrival than a time.perf_counter() call in the consumer coroutine
+    (which may be delayed under concurrent load).
+
+    Queue entry: (cumulative_byte_offset_after_this_chunk, timestamp).
+    """
+    ctx = getattr(trace_config_ctx, "trace_request_ctx", None)
+    if ctx is None or "q" not in ctx:
+        return
+    ctx["bytes"] += len(params.chunk)
+    ctx["q"].append((ctx["bytes"], time.perf_counter()))
+
+
+def _bench_make_trace_config():
+    tc = aiohttp.TraceConfig()
+    tc.on_response_chunk_received.append(_bench_on_response_chunk_received)
+    return tc
+
